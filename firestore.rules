rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection validation document
    match /test/{docId} {
      allow read, write: if isValidId(docId);
    }

    // Cross-platform SaaS User Profiles (Owners, Managers, Cashiers)
    match /saas_users/{userId} {
      allow list: if true;
      allow get: if isValidId(userId);
      allow create, update: if isValidId(userId)
        && request.resource.data.keys().hasAll(['id', 'name', 'email', 'role'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 150
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100;
      allow delete: if isValidId(userId);
    }

    // Cross-platform Monthly Subscription Requests (Super Admin Queue)
    match /subscription_requests/{requestId} {
      allow list: if true;
      allow get: if isValidId(requestId);
      allow create, update: if isValidId(requestId)
        && request.resource.data.keys().hasAll(['id', 'shopId', 'shopName', 'status'])
        && request.resource.data.shopName is string
        && request.resource.data.shopName.size() <= 150;
      allow delete: if isValidId(requestId);
    }

    // Multi-tenant Shop configuration documents & operational subcollections
    match /shops/{shopId} {
      allow list: if true;
      allow get: if isValidId(shopId);
      allow create, update: if isValidId(shopId)
        && request.resource.data.keys().hasAll(['id', 'name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 150;
      allow delete: if isValidId(shopId);

      // Products subcollection
      match /products/{productId} {
        allow list: if true;
        allow get, create, update, delete: if isValidId(shopId) && isValidId(productId);
      }

      // Sales subcollection
      match /sales/{saleId} {
        allow list: if true;
        allow get, create, update, delete: if isValidId(shopId) && isValidId(saleId);
      }

      // Customers & Khata subcollection
      match /customers/{customerId} {
        allow list: if true;
        allow get, create, update, delete: if isValidId(shopId) && isValidId(customerId);
      }

      // Suppliers & Payables subcollection
      match /suppliers/{supplierId} {
        allow list: if true;
        allow get, create, update, delete: if isValidId(shopId) && isValidId(supplierId);
      }

      // Operating Expenses subcollection
      match /expenses/{expenseId} {
        allow list: if true;
        allow get, create, update, delete: if isValidId(shopId) && isValidId(expenseId);
      }

      // Inventory transactions subcollection
      match /inventory_transactions/{transactionId} {
        allow list: if true;
        allow get, create, update, delete: if isValidId(shopId) && isValidId(transactionId);
      }
    }
  }
}
