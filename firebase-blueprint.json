{
  "entities": {
    "Shop": {
      "title": "Shop",
      "description": "Multi-tenant shop profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "ownerName": { "type": "string", "maxLength": 100 },
        "ownerId": { "type": "string" },
        "phone": { "type": "string", "maxLength": 30 },
        "category": { "type": "string", "maxLength": 50 },
        "address": { "type": "string", "maxLength": 200 },
        "city": { "type": "string", "maxLength": 50 },
        "currency": { "type": "string", "maxLength": 10 },
        "taxEnabled": { "type": "boolean" },
        "defaultTaxRate": { "type": "number" },
        "receiptMessage": { "type": "string", "maxLength": 250 },
        "thermalPrinterWidth": { "type": "string", "enum": ["58mm", "80mm"] },
        "allowNegativeStock": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "phone", "category", "currency"]
    },
    "Product": {
      "title": "Product",
      "description": "Inventory product item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "shopId": { "type": "string" },
        "barcode": { "type": "string", "maxLength": 64 },
        "qrCode": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 50 },
        "brand": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 500 },
        "costPrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "taxPercentage": { "type": "number" },
        "stockQuantity": { "type": "number" },
        "minimumStockLimit": { "type": "number" },
        "unit": { "type": "string", "maxLength": 20 },
        "supplierId": { "type": "string" },
        "supplierName": { "type": "string", "maxLength": 100 },
        "expiryDate": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "shopId", "barcode", "name", "costPrice", "sellingPrice", "stockQuantity"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Finalized POS sale invoice",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceNumber": { "type": "string", "maxLength": 50 },
        "shopId": { "type": "string" },
        "cashierId": { "type": "string" },
        "cashierName": { "type": "string", "maxLength": 100 },
        "customerId": { "type": "string" },
        "customerName": { "type": "string", "maxLength": 100 },
        "subtotal": { "type": "number" },
        "discountTotal": { "type": "number" },
        "taxTotal": { "type": "number" },
        "deliveryCharge": { "type": "number" },
        "grandTotal": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["pending", "paid", "refunded"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "invoiceNumber", "shopId", "cashierName", "subtotal", "grandTotal", "paymentStatus"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer record and store credit",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "shopId": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 200 },
        "loyaltyPoints": { "type": "number" },
        "dueBalance": { "type": "number" },
        "totalPurchases": { "type": "number" },
        "notes": { "type": "string", "maxLength": 300 }
      },
      "required": ["id", "shopId", "name", "phone"]
    },
    "InventoryTransaction": {
      "title": "InventoryTransaction",
      "description": "Stock adjustment, stock in, or checkout deduction log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "shopId": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string", "maxLength": 150 },
        "changeQuantity": { "type": "number" },
        "newStockQuantity": { "type": "number" },
        "type": { "type": "string", "enum": ["stock_in", "stock_out", "adjustment", "sale", "refund"] },
        "reason": { "type": "string", "maxLength": 200 },
        "performedBy": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "shopId", "productId", "changeQuantity", "type", "reason", "performedBy"]
    }
  },
  "firestore": {
    "/shops/{shopId}": {
      "schema": "Shop",
      "description": "Store configuration document"
    },
    "/shops/{shopId}/products/{productId}": {
      "schema": "Product",
      "description": "Inventory product item inside a shop"
    },
    "/shops/{shopId}/sales/{saleId}": {
      "schema": "Sale",
      "description": "Completed invoice record"
    },
    "/shops/{shopId}/customers/{customerId}": {
      "schema": "Customer",
      "description": "Customer directory inside a shop"
    },
    "/shops/{shopId}/inventory_transactions/{transactionId}": {
      "schema": "InventoryTransaction",
      "description": "Audit trail of inventory stock adjustments"
    }
  }
}
