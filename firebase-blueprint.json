{
  "entities": {
    "SaasUser": {
      "title": "SaasUser",
      "description": "Multi-tenant business owner, manager, or cashier account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "enum": ["super_admin", "superAdmin", "owner", "manager", "cashier"] },
        "phone": { "type": "string", "maxLength": 30 },
        "password": { "type": "string", "maxLength": 128 },
        "shopId": { "type": "string" },
        "subscriptionPlan": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "SubscriptionRequest": {
      "title": "SubscriptionRequest",
      "description": "Monthly subscription purchase, renewal, or upgrade request for Super Admin review",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "shopId": { "type": "string" },
        "shopName": { "type": "string", "maxLength": 100 },
        "ownerName": { "type": "string", "maxLength": 100 },
        "ownerEmail": { "type": "string", "maxLength": 150 },
        "ownerPhone": { "type": "string", "maxLength": 30 },
        "planId": { "type": "string" },
        "planName": { "type": "string", "maxLength": 100 },
        "amount": { "type": "number" },
        "currency": { "type": "string", "maxLength": 10 },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "paymentReference": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "requestedAt": { "type": "string" },
        "reviewedAt": { "type": "string" },
        "adminNote": { "type": "string", "maxLength": 300 }
      },
      "required": ["id", "shopId", "shopName", "ownerEmail", "planId", "amount", "paymentReference", "status"]
    },
    "Shop": {
      "title": "Shop",
      "description": "Multi-tenant shop profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "ownerName": { "type": "string", "maxLength": 100 },
        "ownerId": { "type": "string" },
        "ownerEmail": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 30 },
        "category": { "type": "string", "maxLength": 50 },
        "address": { "type": "string", "maxLength": 200 },
        "city": { "type": "string", "maxLength": 50 },
        "currency": { "type": "string", "maxLength": 10 },
        "taxEnabled": { "type": "boolean" },
        "defaultTaxRate": { "type": "number" },
        "discountEnabled": { "type": "boolean" },
        "defaultDiscountRate": { "type": "number" },
        "receiptMessage": { "type": "string", "maxLength": 250 },
        "thermalPrinterWidth": { "type": "string", "enum": ["58mm", "80mm", "mm58", "mm80"] },
        "allowNegativeStock": { "type": "boolean" },
        "subscriptionStatus": { "type": "string", "enum": ["pending_approval", "pendingApproval", "active", "expired", "rejected", "blocked"] },
        "subscriptionPlanId": { "type": "string" },
        "subscriptionPlanName": { "type": "string" },
        "subscriptionFee": { "type": "number" },
        "subscriptionPaymentMethod": { "type": "string" },
        "subscriptionPaymentRef": { "type": "string" },
        "subscriptionStartDate": { "type": "string" },
        "subscriptionExpiresAt": { "type": "string" },
        "subscriptionRejectionReason": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "phone", "category", "currency"]
    },
    "Product": {
      "title": "Product",
      "description": "Inventory product item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "shopId": { "type": "string" },
        "barcode": { "type": "string", "maxLength": 64 },
        "qrCode": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 50 },
        "brand": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 500 },
        "costPrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "taxPercentage": { "type": "number" },
        "stockQuantity": { "type": "number" },
        "minimumStockLimit": { "type": "number" },
        "unit": { "type": "string", "maxLength": 20 },
        "supplierId": { "type": "string" },
        "supplierName": { "type": "string", "maxLength": 100 },
        "expiryDate": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "shopId", "barcode", "name", "costPrice", "sellingPrice", "stockQuantity"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Finalized POS sale invoice",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceNumber": { "type": "string", "maxLength": 50 },
        "shopId": { "type": "string" },
        "cashierId": { "type": "string" },
        "cashierName": { "type": "string", "maxLength": 100 },
        "customerId": { "type": "string" },
        "customerName": { "type": "string", "maxLength": 100 },
        "subtotal": { "type": "number" },
        "discountTotal": { "type": "number" },
        "taxTotal": { "type": "number" },
        "deliveryCharge": { "type": "number" },
        "grandTotal": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["pending", "paid", "partially_paid", "partiallyPaid", "refunded", "failed"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "invoiceNumber", "shopId", "cashierName", "subtotal", "grandTotal", "paymentStatus"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer record and Khata store credit",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "shopId": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 200 },
        "loyaltyPoints": { "type": "number" },
        "dueBalance": { "type": "number" },
        "totalPurchases": { "type": "number" },
        "notes": { "type": "string", "maxLength": 300 }
      },
      "required": ["id", "shopId", "name", "phone"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Wholesale supplier and payable balance",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "shopId": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 200 },
        "payableBalance": { "type": "number" },
        "notes": { "type": "string", "maxLength": 300 }
      },
      "required": ["id", "shopId", "name", "phone"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Operating expense record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "shopId": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "category": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 300 },
        "createdBy": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "shopId", "amount", "date", "category"]
    },
    "InventoryTransaction": {
      "title": "InventoryTransaction",
      "description": "Stock adjustment, stock in, or checkout deduction log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "shopId": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string", "maxLength": 150 },
        "changeQuantity": { "type": "number" },
        "newQuantity": { "type": "number" },
        "type": { "type": "string", "enum": ["stock_in", "stock_out", "adjustment", "correction", "damage", "loss", "restock", "sale", "refund", "return"] },
        "reason": { "type": "string", "maxLength": 200 },
        "performedBy": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "shopId", "productId", "changeQuantity", "type", "reason", "performedBy"]
    }
  },
  "firestore": {
    "/saas_users/{userId}": {
      "schema": "SaasUser",
      "description": "SaaS business owner, manager, and cashier accounts"
    },
    "/subscription_requests/{requestId}": {
      "schema": "SubscriptionRequest",
      "description": "Cross-device monthly subscription approval requests for Super Admin"
    },
    "/shops/{shopId}": {
      "schema": "Shop",
      "description": "Store configuration document"
    },
    "/shops/{shopId}/products/{productId}": {
      "schema": "Product",
      "description": "Inventory product item inside a shop"
    },
    "/shops/{shopId}/sales/{saleId}": {
      "schema": "Sale",
      "description": "Completed invoice record"
    },
    "/shops/{shopId}/customers/{customerId}": {
      "schema": "Customer",
      "description": "Customer directory and Khata ledger inside a shop"
    },
    "/shops/{shopId}/suppliers/{supplierId}": {
      "schema": "Supplier",
      "description": "Wholesale supplier directory inside a shop"
    },
    "/shops/{shopId}/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Operating expense logs inside a shop"
    },
    "/shops/{shopId}/inventory_transactions/{transactionId}": {
      "schema": "InventoryTransaction",
      "description": "Audit trail of inventory stock adjustments"
    }
  }
}
